@baseUrl = http://localhost:3000

### 0. List all anomalies
GET {{baseUrl}}/anomaly

### 1. Bad data: negative failed units
POST {{baseUrl}}/anomaly/ingest
Content-Type: application/json

{
  "timestamp": "2026-10-09T10:00:00Z",
  "location": "Warehouse Zone B",
  "supplierId": "SUP-001",
  "supplierName": "Supplier Y",
  "shipmentId": "SHIP-TEST-001",
  "unitsReceived": 1200,
  "unitsFailed": -5
}

### 2. Good data
POST {{baseUrl}}/anomaly/ingest
Content-Type: application/json

{
  "timestamp": "2026-10-09T10:00:00Z",
  "location": "Warehouse Zone B",
  "supplierId": "SUP-001",
  "supplierName": "Supplier Y",
  "shipmentId": "SHIP-TEST-002",
  "unitsReceived": 1200,
  "unitsFailed": 180
}

### 3. A field the client is not allowed to send
POST {{baseUrl}}/anomaly/ingest
Content-Type: application/json

{
  "timestamp": "2026-10-09T10:00:00Z",
  "location": "Warehouse Zone B",
  "supplierId": "SUP-001",
  "supplierName": "Supplier Y",
  "shipmentId": "SHIP-TEST-003",
  "unitsReceived": 1200,
  "unitsFailed": 180,
  "status": "resolved"
}

### 4. Text instead of a number
POST {{baseUrl}}/anomaly/ingest
Content-Type: application/json

{
  "timestamp": "2026-10-09T10:00:00Z",
  "location": "Warehouse Zone B",
  "supplierId": "SUP-001",
  "supplierName": "Supplier Y",
  "shipmentId": "SHIP-TEST-004",
  "unitsReceived": "abc",
  "unitsFailed": 180
}


### 5. More failed units than received (150 > 100)
POST {{baseUrl}}/anomaly/ingest
Content-Type: application/json

{
  "timestamp": "2026-10-09T10:00:00Z",
  "location": "Warehouse Zone B",
  "supplierId": "SUP-001",
  "supplierName": "Supplier Y",
  "shipmentId": "SHIP-TEST-005",
  "unitsReceived": 100,
  "unitsFailed": 150
}

### 6. Edge case: every unit failed (100 of 100), which is allowed
POST {{baseUrl}}/anomaly/ingest
Content-Type: application/json

{
  "timestamp": "2026-10-09T10:00:00Z",
  "location": "Warehouse Zone B",
  "supplierId": "SUP-001",
  "supplierName": "Supplier Y",
  "shipmentId": "SHIP-TEST-006",
  "unitsReceived": 100,
  "unitsFailed": 100
}

### 7. Shipment with inspector notes (free text, optional)
POST {{baseUrl}}/anomaly/ingest
Content-Type: application/json

{
  "timestamp": "2026-10-09T10:00:00Z",
  "location": "Warehouse Zone A",
  "inspectorNotes": "Two cartons crushed on one corner, contents undamaged.",
  "supplierId": "SUP-002",
  "supplierName": "Atlas Components",
  "shipmentId": "SHIP-TEST-007",
  "unitsReceived": 800,
  "unitsFailed": 6
}

### 8. Duplicate: this shipment number already exists (from the seed) → 409
POST {{baseUrl}}/anomaly/ingest
Content-Type: application/json

{
  "timestamp": "2026-07-21T08:00:00Z",
  "location": "Warehouse Zone B",
  "supplierId": "SUP-001",
  "supplierName": "Supplier Y",
  "shipmentId": "SHIP-2026-00001",
  "unitsReceived": 1150,
  "unitsFailed": 19
}

